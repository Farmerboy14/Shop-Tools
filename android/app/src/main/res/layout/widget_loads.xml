<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widgetJob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="10sp"
        android:textStyle="bold"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/widgetCount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="22sp"
        android:autoSizeMaxTextSize="64sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textStyle="bold"
        android:text="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widgetMinus"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn"
            android:text="−"
            android:textColor="@color/muted"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widgetPlus"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="2"
            android:background="@drawable/bg_btn_accent"
            android:text="+"
            android:textColor="@color/accent_ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
